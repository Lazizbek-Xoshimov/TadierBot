{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://tadierbot.runasp.net/api/:path*"
    },
    {
      "source": "/audio/:path*",
      "destination": "http://tadierbot.runasp.net/audio/:path*"
    },
    {
      "source": "/texts/:path*",
      "destination": "http://tadierbot.runasp.net/texts/:path*"
    }
  ]
}
